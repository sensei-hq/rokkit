        "name": "icons",
        "type": "{ opened?: string; closed?: string }",
      },
      {
        "desc": "Localized labels (root role label etc.)",
        "name": "labels",
        "type": "Record<string, string>",
      },
      {
        "default": "''",
        "desc": "Extra CSS classes",
        "name": "class",
        "type": "string",
      },
    ],
  },
  "category": "data",
  "description": "Tree with on-demand child fetching — declare \`children: true\`, resolve via \`onlazyload\`.",
  "docsLength": 2061,
  "icon": "枝",
  "id": "lazy-tree",
  "inline": {
    "capable": true,
  },
  "keywords": [
    "lazy-tree",
    "async-tree",
    "on-demand",
    "paginated-tree",
    "file-tree",
