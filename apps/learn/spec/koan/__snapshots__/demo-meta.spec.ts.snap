        "type": "(id: string, node: GraphNode) => void",
      },
      {
        "desc": "The reader climbed out to \`path\`. Answer from what you already hold (no refetch) or return a promise, same contract as ondrill",
        "name": "ondrillup",
        "type": "(path: string[]) => void | Promise<void>",
      },
