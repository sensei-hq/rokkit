      },
      {
        "desc": "Card header strip",
        "selector": "[data-graph-node-head]",
      },
      {
        "desc": "Kind icon",
        "selector": "[data-graph-node-icon]",
      },
      {
        "desc": "Node label",
        "selector": "[data-graph-node-title]",
      },
      {
        "desc": "Kind spelled out beside the icon (underscores rendered as spaces). Hidden below \`full\` detail and in the points layout",
