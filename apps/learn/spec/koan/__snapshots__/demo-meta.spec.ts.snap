        "type": "'sm' | 'md' | 'lg'",
      },
      {
        "default": "'start'",
        "desc": "Dropdown horizontal alignment",
        "name": "align",
        "type": "'start' | 'end'",
      },
      {
        "default": "'down'",
        "desc": "Dropdown open direction",
        "name": "direction",
        "type": "'down' | 'up'",
      },
      {
        "default": "false",
        "desc": "Disable the entire select",
        "name": "disabled",
        "type": "boolean",
      },
      {
        "default": "false",
        "desc": "Show a filter input above the options",
        "name": "filterable",
        "type": "boolean",
      },
      {
        "desc": "Placeholder for the filter input",
        "name": "filterPlaceholder",
        "type": "string",
      },
    ],
  },
  "category": "forms",
  "description": "Single-pick dropdown. Field-mapped items, keyboard nav, bound value. The flat single-pick counterpart to MultiSelect.",
  "docsLength": 1719,
  "icon": "択",
  "id": "select",
  "inline": {
    "capable": true,
  },
  "keywords": [
    "select",
    "dropdown",
    "picker",
    "choose",
    "pick",
    "option",
    "options",
    "single",
