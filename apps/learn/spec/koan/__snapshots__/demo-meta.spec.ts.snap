  let active = $state('Overview')
  const items = ['Overview', 'Details', 'Settings']
</script>

<Tabs {items} bind:value={active} />",
      "id": "intro",
      "lang": "svelte",
      "title": "Basic — string items",
    },
    {
      "code": "<script>
  import { Tabs } from '@rokkit/ui'
  const items = [
    { id: 'a', title: 'Overview', body: 'Welcome' },
    { id: 'b', title: 'Details',  body: 'Specs go here' }
  ]
  let active = $state('a')
</script>

<Tabs
  {items}
  bind:value={active}
  fields={{ label: 'title', value: 'id' }}
/>",
      "id": "objects",
      "lang": "svelte",
      "title": "Object items + field mapping",
    },
    {
      "code": "<Tabs
  items={['One', 'Two', 'Three']}
  orientation="vertical"
  position="left"
  align="start"
/>",
      "id": "configuration",
      "lang": "svelte",
      "title": "Layout — orientation + position + align",
    },
    {
      "code": "<script>
  import { Tabs } from '@rokkit/ui'
  let items = $state([{ label: 'Untitled' }])
  let active = $state('Untitled')
</script>

<Tabs
  bind:items
  bind:value={active}
  editable
  onadd={() => (items = [...items, { label: 'New tab' }])}
  onremove={(t) => (items = items.filter((i) => i !== t))}
/>",
      "id": "editable",
      "lang": "svelte",
      "title": "Editable — add / remove",
    },
    {
      "code": "<Tabs options={[
  { value: 'overview', label: 'Overview', content: 'Welcome to the overview.' },
  { value: 'api',      label: 'API',      content: 'API docs here.',   icon: 'i-lucide:code' },
  { value: 'examples', label: 'Examples', content: 'Usage examples here.' }
]} bind:value />

<!-- icon and label render in the trigger automatically;
     content renders in the panel — no snippets needed. -->",
      "id": "defaults",
      "lang": "svelte",
      "title": "Icons, labels, panel content — all data (no snippet)",
    },
    {
      "code": "<script>
  const options = [
    { value: 'overview', label: 'Overview', content: 'Overview panel.' },
    { value: 'live',     label: 'Live',     content: 'Live feed.',  snippet: 'live' },  // custom trigger; others default
    { value: 'settings', label: 'Settings', content: 'Settings panel.' }
  ]
</script>

<Tabs {options} bind:value>
  {#snippet live(proxy, selected)}
    <span class="i-lucide:radio" aria-hidden="true"></span>
    <span>{proxy.label}</span>
    <span class="size-2 rounded-full bg-danger"></span>
  {/snippet}
</Tabs>",
      "id": "named",
      "lang": "svelte",
      "title": "Custom trigger markup for one tab (Tier 2)",
    },
    {
      "code": "<Tabs {options} bind:value class="
  [&_[data-tabs-trigger]]:px-4
  [&_[data-tabs-trigger][data-selected]]:font-semibold
  [&_[data-tabs-panel]]:p-6
" />",
      "id": "theming",
      "lang": "svelte",
      "title": "Theme via class (UnoCSS arbitrary variants)",
    },
  ],
  "title": "Tabs",
  "tool": {
    "description": "Mount a Tabs component on the canvas. Use when the user asks for tabbed navigation, switchable panels, or content split across labeled views.",
    "name": "mount_tabs",
    "parameters": {
      "items": "Array<{ label: string, content?: string }> — at least 2 items",
      "value": "optional initially-active tab label",
    },
  },
  "variants": [
    {
      "id": "vertical",
      "label": "Vertical orientation",
      "mode": "dynamic",
      "props": {
        "orientation": "vertical",
      },
    },
    {
      "id": "with-icons",
      "label": "With icons",
      "mode": "dynamic",
    },
  ],
}
`;

