      },
      {
        "desc": "Total row count",
        "selector": "[data-graph-node-count]",
      },
      {
        "desc": "One visible row",
        "selector": "[data-graph-row]",
      },
      {
        "desc": "Row name",
        "selector": "[data-graph-row-name]",
      },
      {
        "desc": "Row type — ink-mute, never ink-soft",
